# Valeurs FACTICES — copier vers un fichier hors dépôt, ne jamais committer de vraies valeurs.
# Exécution depuis le VPS (ubuntu) ou depuis un poste avec accès SSH ; aucune valeur n'est affichée par les scripts.

# Accès SQL Server (sauvegarde avant bascule) — mot de passe SA fourni à l'exécution
SQLSERVER_CONTAINER=sql-server-dev
SQLSERVER_DATABASE=sfd
# export SQLSERVER_SA_PASSWORD=...          # saisi à la main, jamais écrit sur disque

# PostgreSQL de dev (conteneur existant pg_container, image postgres:15.2)
PG_CONTAINER=pg_container
PG_ADMIN_USER=root
# export PG_ADMIN_PASSWORD=...              # saisi à la main
PG_DATABASE=sfd
PG_APP_USER=sfd_app
# le mot de passe de PG_APP_USER est GÉNÉRÉ par 02-prepare-postgres.sh et écrit uniquement dans le fichier ci-dessous (chmod 600)
PG_ENV_FILE=/opt/sfd/env/sfd-pg-dev.env

DEV_NETWORK=dev-network
BACKUP_ROOT=/opt/sfd/backups/pre-pg
